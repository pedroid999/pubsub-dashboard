{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/server"
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/cli/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/client",
    "tests/**/*.tsx",
    "tests/unit/client.*.ts"
  ]
}
