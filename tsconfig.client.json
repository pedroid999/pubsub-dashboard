{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": "dist/client"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/shared/**/*.ts",
    "src/server/schemas/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/setup.client.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/server/routes",
    "src/server/middleware",
    "src/server/auth"
  ]
}
