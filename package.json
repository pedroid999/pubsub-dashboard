{
  "name": "pubsub-dashboard",
  "version": "0.2.1",
  "description": "Local-first developer dashboard for Google Cloud Pub/Sub — runs entirely on 127.0.0.1, authenticates via gcloud ADC, zero telemetry.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pubsub",
    "google-cloud",
    "gcp",
    "dashboard",
    "local-first",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/pedroid999/pubsub-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroid999/pubsub-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/pedroid999/pubsub-dashboard/issues"
  },
  "bin": {
    "pubsub-dashboard": "bin/pubsub-dashboard.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench": "tsx tests/perf/cold-boot.bench.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run e2e"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@hono/node-server": "^1.13.0",
    "google-auth-library": "^9.14.0",
    "hono": "^4.6.0",
    "open": "^10.1.0",
    "pino": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.453.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
